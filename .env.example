# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# QuickBooks
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://127.0.0.1:8000/callback
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# OpenAI
OPENAI_API_KEY=

# Email verification / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
EMAIL_VERIFICATION_EXPIRY_MINUTES=30

# Local development only. Never enable in production.
EMAIL_VERIFICATION_DEBUG_LINKS=false

# Local ATO workflow testing only. Never treat this as real lodgement.
ENABLE_MOCK_ATO_LODGEMENT=false

# Local database
BAS_DATABASE_FILE=bas_history.db

# Sandbox BAS defaults
QBO_WAGE_ACCOUNT_ID=66
QBO_PAYG_ACCOUNT_ID=49
DEFAULT_BAS_START=2026-09-03
DEFAULT_BAS_END=2026-09-30
